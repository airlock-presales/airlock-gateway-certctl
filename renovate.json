{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "rangeStrategy": "bump",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "dependencyDashboardApproval": false,
  "minimumReleaseAge": "0 days",
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "description": "Automatically merge all dependency updates after successful CI",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance",
        "rollback"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}