{
  "enabledManagers": [
    "gomod"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "enabled": false
    },
    {
      "description": "Go patch updates",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": true,
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Go minor updates",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "enabled": true,
      "rangeStrategy": "bump"
    }
  ]
}